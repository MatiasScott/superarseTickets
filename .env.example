# ============================
# CONFIGURACIÓN DEL SITIO
# ============================
APP_NAME=ISTS Ticket System
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/istsTicket

# ============================
# BASE DE DATOS
# ============================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=istsTicket
DB_USER=root
DB_PASSWORD=Superarse.2025
DB_CHARSET=utf8mb4

# ============================
# BASE DE DATOS SUPERARSE (CRM)
# ============================
# Si no se configuran estas variables, CRM usara fallback local.
SUPERARSE_DB_HOST=localhost
SUPERARSE_DB_PORT=3306
SUPERARSE_DB_DATABASE=superar1_conectados
SUPERARSE_DB_USERNAME=root
SUPERARSE_DB_PASSWORD=Superarse.2025
SUPERARSE_DB_CHARSET=utf8mb4

# ============================
# CORREO (MAIL)
# ============================
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_ENCRYPTION=tls
MAIL_IMAP_HOST=outlook.office365.com
MAIL_IMAP_PORT=993
MAIL_IMAP_ENCRYPTION=ssl
MAIL_FROM_EMAIL=noreply@ists.local
MAIL_FROM_NAME=ISTS Ticket System

# Bootstrap historico de tickets (primera carga)
MAIL_TICKET_HISTORY_BOOTSTRAP_ENABLED=true
MAIL_TICKET_HISTORY_YEARS=3

# Multi-cuenta de correo (dinamico)
MAIL_ACCOUNTS_TOTAL=10
MAIL_ACCOUNT_STRATEGY=round_robin
MAIL_DEFAULT_ACCOUNT_ALIAS=acc1

MAIL_ACCOUNT_1_ALIAS=acc1
MAIL_ACCOUNT_1_NAME=Soporte 1
MAIL_ACCOUNT_1_EMAIL=soporte1@tu-dominio.com
MAIL_ACCOUNT_1_USERNAME=soporte1@tu-dominio.com
MAIL_ACCOUNT_1_PASSWORD=clave1
MAIL_ACCOUNT_1_HOST=smtp.tu-dominio.com
MAIL_ACCOUNT_1_PORT=587
MAIL_ACCOUNT_1_ENCRYPTION=tls
MAIL_ACCOUNT_1_IMAP_HOST=outlook.office365.com
MAIL_ACCOUNT_1_IMAP_PORT=993
MAIL_ACCOUNT_1_IMAP_ENCRYPTION=ssl
MAIL_ACCOUNT_1_ENABLED=true

