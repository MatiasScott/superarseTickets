# ============================
# CONFIGURACIÓN DEL SITIO
# ============================
APP_NAME=ISTS Ticket System
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/istsTicket

# ============================
# BASE DE DATOS
# ============================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=istsTicket
DB_USER=root
DB_PASSWORD=Superarse.2025
DB_CHARSET=utf8mb4

# ============================
# CORREO (MAIL)
# ============================
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_ENCRYPTION=tls
MAIL_FROM_EMAIL=noreply@ists.local
MAIL_FROM_NAME=ISTS Ticket System

# Para usar sendmail local
# MAIL_DRIVER=sendmail
# SENDMAIL_PATH=/usr/sbin/sendmail -bs

# ============================
# TELÉFONO Y SMS
# ============================
SMS_PROVIDER=twilio

# Twilio Configuration
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Nexmo/Vonage Configuration
NEXMO_ENABLED=false
NEXMO_API_KEY=your_nexmo_api_key
NEXMO_API_SECRET=your_nexmo_api_secret
NEXMO_FROM_NUMBER=ISTS

# AWS SNS Configuration
SNS_ENABLED=false
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1

# ============================
# BOTS Y AUTOMATIZACIÓN
# ============================

# WhatsApp Bot
BOT_WHATSAPP_ENABLED=false
BOT_WHATSAPP_PHONE=+34600000000
BOT_WHATSAPP_API_KEY=your_whatsapp_api_key
BOT_WHATSAPP_WEBHOOK=https://example.com/webhooks/whatsapp

# Telegram Bot
BOT_TELEGRAM_ENABLED=false
BOT_TELEGRAM_TOKEN=your_telegram_bot_token
BOT_TELEGRAM_WEBHOOK=https://example.com/webhooks/telegram

# Facebook Messenger Bot
BOT_MESSENGER_ENABLED=false
BOT_MESSENGER_TOKEN=your_messenger_page_token
BOT_MESSENGER_VERIFY_TOKEN=your_messenger_verify_token
BOT_MESSENGER_WEBHOOK=https://example.com/webhooks/messenger

# Email Bot
BOT_EMAIL_ENABLED=true

# SMS Bot
BOT_SMS_ENABLED=false

# ============================
# COLA DE MENSAJES
# ============================
MAIL_QUEUE_ENABLED=false
QUEUE_DRIVER=database

# ============================
# SESIÓN
# ============================
SESSION_DRIVER=file
SESSION_LIFETIME=120
