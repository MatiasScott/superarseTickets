RewriteEngine On

# Sirve archivos reales desde public/ manteniendo la URL base /istsTicket
RewriteCond %{REQUEST_URI} !^/istsTicket/public/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/$1 [L,QSA]

# Si se solicita la raiz del proyecto, entra al front controller publico
DirectoryIndex public/index.php